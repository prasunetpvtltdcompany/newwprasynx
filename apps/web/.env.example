# PRASYNX Web Portal - Environment Variables for Vercel / Local

# Monolith API Base URL (e.g., https://api.prasynx.prasunet.com or http://localhost:4000)
API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Supabase Public Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional Marketing / Platform Site URL
NEXT_PUBLIC_PLATFORM_URL=https://prasynx.in
